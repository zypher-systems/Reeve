# Maintainer: Zypher Systems <zypher@zyphersystems.com>
#
# Built from source, following the Arch Rust package guidelines.
pkgname=reeve
pkgver=0.1.3
pkgrel=1
pkgdesc="An operator agent that manages this computer, with receipts"
arch=('x86_64' 'aarch64')
url="https://github.com/zypher-systems/reeve"
license=('Apache-2.0')
depends=('bash' 'sudo' 'util-linux' 'systemd' 'gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=('libnotify: desktop notifications for findings'
            'snapper: snapshots around root changes')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    # rust-toolchain.toml pins the developers' toolchain; use Arch's.
    rm -f rust-toolchain.toml
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release -p reeve-cli
}

check() {
    cd "$pkgname-$pkgver"
    target/release/reeve --version
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/reeve "$pkgdir/usr/bin/reeve"
    install -Dm644 packaging/systemd/reeved.service "$pkgdir/usr/lib/systemd/user/reeved.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md config.example.toml -t "$pkgdir/usr/share/doc/$pkgname/"
}
